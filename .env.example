# Supabase — crea el proyecto en https://supabase.com y copia estos valores.
# La app funciona 100% offline sin estas variables (modo solo-local).
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=
# Nota: La publishable key (sb_publishable_...) es la que antes se llamaba anon key.
# Es pública por diseño (segura con RLS). NUNCA se debe poner la sb_secret_... aquí.

VITE_SUPABASE_URL=https://sxilpfedbywbmyuvvbjg.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_zN0TTAIklWWykaGG5vQDCg_OkvUPSyo

# Push notifications (Sprint 5b-2) — generar con: npx web-push generate-vapid-keys --json
# Solo la clave pública va en el frontend. La privada NUNCA se commitea: vive como secret
# en Supabase Edge Functions (VAPID_PRIVATE_KEY).
VITE_VAPID_PUBLIC_KEY=tu_clave_publica_aqui